# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ─── Database ─────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/angaza_awards
# DATABASE_URL=postgresql://user:password@localhost:5432/angaza_awards

# ─── JWT / Auth ───────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret
